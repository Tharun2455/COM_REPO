
library ieee;
use ieee.std_logic_1164.all;

entity adar_spi_shift is
    Port (
        clk        : in  STD_LOGIC;
        reset      : in  STD_LOGIC;
        en         : in  STD_LOGIC;
        data_in    : in  STD_LOGIC_VECTOR(23 downto 0);

        data_out   : out STD_LOGIC_VECTOR(7 downto 0);
        data_out_v : out STD_LOGIC;
        spi_busy   : out STD_LOGIC;

        cs         : out STD_LOGIC;
        sdi        : in  STD_LOGIC;
        sdo        : out STD_LOGIC;
        sck        : out STD_LOGIC
    );
end adar_spi_shift;

architecture Behavioral of adar_spi_shift is

    type t_State is (
        idle,
        cs_shift_0,
        cs_shift_0_d,
        clk_shift_0,
        clk_shift_0_d,
        clk_shift_1,
        clk_shift_1_d,
        gen_valid
    );

    signal State : t_State := idle;

    signal data_in_lat : std_logic_vector(23 downto 0)
                       := (others => '0');

    signal data_out_t : std_logic_vector(23 downto 0)
                      := (others => '0');

    signal bit_cnt : integer range 0 to 23 := 23;

begin

    process(clk)
    begin
        if rising_edge(clk) then

            if reset = '1' then

                State       <= idle;
                bit_cnt     <= 23;

                data_in_lat <= (others => '0');
                data_out_t  <= (others => '0');

                data_out    <= (others => '0');
                data_out_v  <= '0';
                spi_busy    <= '0';

                sdo         <= '1';
                sck         <= '1';
                cs          <= '1';

            else

                -- Default: one-clock valid pulse
                data_out_v <= '0';

                case State is

                    when idle =>

                        bit_cnt <= 23;
                        sdo     <= '1';
                        sck     <= '1';
                        cs      <= '1';

                        if en = '1' then

                            data_in_lat <= data_in;
                            spi_busy    <= '1';
                            State       <= cs_shift_0;

                        else

                            spi_busy <= '0';
                            State    <= idle;

                        end if;

                    when cs_shift_0 =>

                        cs    <= '0';
                        State <= cs_shift_0_d;

                    when cs_shift_0_d =>

                        State <= clk_shift_0;

                    when clk_shift_0 =>

                        sdo   <= data_in_lat(bit_cnt);
                        sck   <= '0';
                        State <= clk_shift_0_d;

                    when clk_shift_0_d =>

                        State <= clk_shift_1;

                    when clk_shift_1 =>

                        data_out_t(bit_cnt) <= sdi;
                        sck                 <= '1';
                        State               <= clk_shift_1_d;

                    when clk_shift_1_d =>

                        if bit_cnt = 0 then

                            State <= gen_valid;

                        else

                            bit_cnt <= bit_cnt - 1;
                            State   <= clk_shift_0;

                        end if;

                    when gen_valid =>

                        data_out   <= data_out_t(7 downto 0);
                        data_out_v <= '1';
                        spi_busy   <= '0';

                        sck <= '1';
                        cs  <= '1';
                        sdo <= '1';

                        State <= idle;

                    when others =>

                        State    <= idle;
                        spi_busy <= '0';

                        cs  <= '1';
                        sck <= '1';
                        sdo <= '1';

                end case;

            end if;
        end if;
    end process;

end Behavioral;
