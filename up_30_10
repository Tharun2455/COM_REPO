    );

begin 

    ------------------------------------------------------------------
    -- Top-Level Board Driver Control Assignments
    ------------------------------------------------------------------
    FPGA_EN_28NV_DC_DC7149_1 <= '1';
    FPGA_3_3v_1              <= '1';
    PA_ON_1_1                <= '1';
    PA_ON_2_1                <= '1';
    PA_ON_3_1                <= '1';
    PA_ON_4_1                <= '1';

    RX_EN_ADAR_1_1           <= '1';
    RX_EN_ADAR_2_1           <= '1';
    RX_EN_ADAR_5_1           <= '1';
    RX_EN_ADAR_6_1           <= '1';
    RX_EN_ADAR_3_1           <= '1';
    RX_EN_ADAR_4_1           <= '1';
    RX_EN_ADAR_7_1           <= '1';
    RX_EN_ADAR_8_1           <= '1';
    RX_EN_ADAR_9_1           <= '1';
    RX_EN_ADAR_10_1          <= '1';
    RX_EN_ADAR_11_1          <= '1';
    RX_EN_ADAR_12_1          <= '1';
    RX_EN_ADAR_13_1          <= '1';
    RX_EN_ADAR_14_1          <= '1';
    RX_EN_ADAR_15_1          <= '1';
    RX_EN_ADAR_16_1          <= '1';


    CMD_TYPE_NOP             <= CMD_TYPE_NOP_S;
    STATUS_TYPE              <= STATUS_TYPE_S;
    FLASH_CMD                <= FLASH_CMD_S;
    FLASH_INPUT_FRAME        <= FLASH_INPUT_FRAME_S;

    
    
  
    
    FPGA_TR_ADAR1            <= INT_TRP_I;
    FPGA_TR_ADAR2            <= INT_TRP_I;
    FPGA_TR_ADAR3            <= INT_TRP_I;
    FPGA_TR_ADAR4            <= INT_TRP_I;


    FPGA_SPI_BUFF_CTRL_G1_1  <= '0';
    FPGA_SPI_BUFF_CTRL_G2_1  <= '0';
    FPGA_SPI_BUFF_CTRL_G3_1  <= '0';
    FPGA_SPI_BUFF_CTRL_G4_1  <= '0';

    DC_DC_Control_Buffer_1   <= '0';
    BUFF_ENABLE_TX_TR_SW_1   <= '0';
    FPGA_EN_n5V_DC_DC7149_1  <= '1';
