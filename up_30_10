    FPGA_RX_EN_G1_G2_1       <= '0';
    FPGA_RX_EN_G3_G4_1       <= '0';

    ------------------------------------------------------------------
    -- 4 SPI Controller Instantiations
    ------------------------------------------------------------------
    adar1_spi_ctrl_inst: spi_wrap 
        port map(
            reset           => SYS_RESET_I,
            CLK_50MHz_I     => CLK_50MHz_I,
            data_frame_in   => data_frame_in_adar1_s,
            word_count      => word_count_adar1_s,
