------------------------------------------------------------------
    -- Command Trigger & Pipeline Process
    ------------------------------------------------------------------
    process(CLK_50MHz_I, SYS_RESET_I) 
    begin 
        if (SYS_RESET_I = '1') then
            CMD_TYPE            <= X"00";
            CHANNEL_SEL         <= X"00";
            CMD_TYPE_NOP_S      <= X"00";
            STATUS_TYPE_S       <= X"0";
            packet_size_id      <= X"00";
            trm_controlbyte     <= X"00";
            FLASH_CMD_S         <= X"00";
            FLASH_INPUT_FRAME_S <= (others => (others => '0'));
            data_adar_flag_raw  <= '0';
            data_adar_flag_d1   <= '0';

        elsif rising_edge(CLK_50MHz_I) then
            data_adar_flag_raw <= '0';
            
            -- Combine UART trigger flag and Power-On-Reset flag
            data_adar_flag_d1 <= data_adar_flag_raw or por_flag_raw;

            if FLAG_FRAME = '1' then
                packet_size_id <= RX_FRAME(1);
                CMD_TYPE       <= RX_FRAME(2);
                CHANNEL_SEL    <= RX_FRAME(5);

                -- Capture control byte ONLY when packet size ID is 0x40
                if (RX_FRAME(1) = X"40") then
                    trm_controlbyte <= RX_FRAME(9);
                end if;

                -- Trigger logic based on command types
                if (RX_FRAME(2) >= X"00" and RX_FRAME(2) <= X"05") then
                    data_adar_flag_raw <= '1'; 

                elsif (RX_FRAME(1) = X"40" and RX_FRAME(2) = X"06") then
                    data_adar_flag_raw <= '1'; 

                elsif (RX_FRAME(2) = X"08") then
                    CMD_TYPE_NOP_S <= RX_FRAME(2);
                    STATUS_TYPE_S  <= RX_FRAME(5)(3 downto 0);

                elsif (RX_FRAME(2) = X"0A") then
                    FLASH_CMD_S <= RX_FRAME(2);
                    for i in 0 to 9 loop
                        FLASH_INPUT_FRAME_S(i) <= RX_FRAME(i); 
                    end loop;
                end if;
            end if;
        end if;



------------------------------------------------------------------
                    -- WHEN 0x06: RX PATTERN MODE (Executes ONLY when Packet Size ID = 0x40)
                    ------------------------------------------------------------------
                    when X"06" =>
                        -- Check both Packet Size ID (0x40) and Control Byte (0x01) directly
                        if (RX_FRAME(1) = X"40" and RX_FRAME(9) = X"01") then 
                            
                            -- ADAR 1 Sequence (28 Words)
                            data_frame_in_adar1_s(0)  <= "0" & "01" & "00000" & x"3104"; 
                            data_frame_in_adar1_s(1)  <= "0" & "01" & "00000" & x"2E7F"; 
                            data_frame_in_adar1_s(2)  <= "0" & "01" & "00000" & x"3408"; 
                            data_frame_in_adar1_s(3)  <= "0" & "01" & "00000" & x"3555";
                            data_frame_in_adar1_s(4)  <= "0" & "01" & "00000" & x"2D18"; 
                            data_frame_in_adar1_s(5)  <= "0" & "01" & "00000" & x"4AFF"; 
                            data_frame_in_adar1_s(6)  <= "0" & "01" & "00000" & x"2801";
                            
                            data_frame_in_adar1_s(7)  <= "0" & "10" & "00000" & x"3104"; 
                            data_frame_in_adar1_s(8)  <= "0" & "10" & "00000" & x"2E7F"; 
                            data_frame_in_adar1_s(9)  <= "0" & "10" & "00000" & x"3408"; 
                            data_frame_in_adar1_s(10) <= "0" & "10" & "00000" & x"3555";
                            data_frame_in_adar1_s(11) <= "0" & "10" & "00000" & x"2D18"; 
                            data_frame_in_adar1_s(12) <= "0" & "10" & "00000" & x"4AFF"; 
                            data_frame_in_adar1_s(13) <= "0" & "10" & "00000" & x"2801";
                            
                            data_frame_in_adar1_s(14) <= "0" & "11" & "00000" & x"3104"; 
                            data_frame_in_adar1_s(15) <= "0" & "11" & "00000" & x"2E7F"; 
                            data_frame_in_adar1_s(16) <= "0" & "11" & "00000" & x"3408"; 
                            data_frame_in_adar1_s(17) <= "0" & "11" & "00000" & x"3555";
                            data_frame_in_adar1_s(18) <= "0" & "11" & "00000" & x"2D18"; 
                            data_frame_in_adar1_s(19) <= "0" & "11" & "00000" & x"4AFF"; 
                            data_frame_in_adar1_s(20) <= "0" & "11" & "00000" & x"2801";
                            
                            data_frame_in_adar1_s(21) <= "0" & "00" & "00000" & x"3104"; 
                            data_frame_in_adar1_s(22) <= "0" & "00" & "00000" & x"2E7F"; 
                            data_frame_in_adar1_s(23) <= "0" & "00" & "00000" & x"3408"; 
                            data_frame_in_adar1_s(24) <= "0" & "00" & "00000" & x"3555";
                            data_frame_in_adar1_s(25) <= "0" & "00" & "00000" & x"2D18"; 
                            data_frame_in_adar1_s(26) <= "0" & "00" & "00000" & x"4AFF"; 
                            data_frame_in_adar1_s(27) <= "0" & "00" & "00000" & x"2801";

                            -- Copy array data to ADAR 2, 3, and 4
                            data_frame_in_adar2_s(0 to 27) <= data_frame_in_adar1_s(0 to 27);
                            data_frame_in_adar3_s(0 to 27) <= data_frame_in_adar1_s(0 to 27);
                            data_frame_in_adar4_s(0 to 27) <= data_frame_in_adar1_s(0 to 27);

                            -- Set exact word count for the 28-word pattern sequence
                            word_count_adar1_s <= 28;
                            word_count_adar2_s <= 28;
                            word_count_adar3_s <= 28;
                            word_count_adar4_s <= 28;
                        end if;

    end process;
