		--IF (DATA_UPDATE_FLAG = '1' and power_on_reset_adar_completed_flag = '1') THEN
			CASE COMMAND_OP_REG_adar_update IS
			--CASE COMMAND_OP_REG IS          
				WHEN X"02" =>            -- RX_CALIBRATION  
----	----------------------------------test 3_d adar_data----------------------------------------------------------
                  for k in 1 to no_of_adars loop
