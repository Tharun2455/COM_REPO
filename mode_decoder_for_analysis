                            adar_data_frame_in(k)(3*(i-1)+22)<= CH_RX_PHASE_Q_REGISTER_ADDRESS(i) & CH_PHASE_Q_RX_NEXT_ADAR_MAPPING(4*(k-1)+ i) ;
                        END LOOP;          
						adar_data_frame_in (k)(32) <= '0' & a14_TO_a11_ADAR_SLECTION & "000" & X"2E" & X"00" ; 	--DISABLE RX PATH FOR ALL CHANNEL
						adar_data_frame_in (K)(33) <= '0' & a14_TO_a11_ADAR_SLECTION & "000" & X"2F" & '0' & control_bits_TRM_reg(4*(K-1)+1)(1) & control_bits_TRM_reg(4*(K-1)+2)(1) & control_bits_TRM_reg(4*(K-1)+3)(1) & control_bits_TRM_reg(4*(K-1)+4)(1) & "111" ;----TX ENABLE CH
                        --adar_data_frame_in (k)(34) <= '0' & a14_TO_a11_ADAR_SLECTION & "000" & X"28" & X"03" ;   -- LOADING TX AND RX WORKING REGISTER 
                        word_count_adar_s(k)<= 34;
							IF(adar_spi_busy_flag_s(k) = '0') THEN
								adar_data_frame_in_flag(k)<= '1';
							ELSE
								adar_data_frame_in_flag(k)<= '0';           
							END IF;
            end loop;
 ---------------------------------------------------------------------------------------------------------------------- 
				WHEN X"01"    =>                  --DWELL MODE
--------------------------------------adar1_data----------------------------------------------------------
			for k in 1 to no_of_adars loop
                        adar_data_frame_in(k)(0)   <= '0' & a14_TO_a11_ADAR_SLECTION & "000" & X"00" & X"18" ;    -- USE SDO READBACK
						adar_data_frame_in(k)(1)   <= '0' & a14_TO_a11_ADAR_SLECTION & "000" & X"38" & X"60" ;    -- USE SPI FOR CHANNEL SETTINGS
						adar_data_frame_in(k)(2)   <= '0' & a14_TO_a11_ADAR_SLECTION & "000" & X"30" & X"20" ;   --  PA AND LNA bias  current DISABLE
						adar_data_frame_in(k)(3)   <= '0' & a14_TO_a11_ADAR_SLECTION & "000" & X"34" & X"08" ;    -- X"08" for NOMINAL BIAS SETTINGS/X"05" for LOW BIAS SETTINGS FOR RECEIVER RF SUBCIRCUITS
						adar_data_frame_in(k)(4)   <= '0' & a14_TO_a11_ADAR_SLECTION & "000" & X"35" & X"55" ;    -- X"55" for NOMINAL BIAS SETTINGS/X"1A" for LOW BIAS SETTINGS FOR RECEIVER RF SUBCIRCUITS 
						adar_data_frame_in(k)(5)   <= '0' & a14_TO_a11_ADAR_SLECTION & "000" & X"36" & X"2D" ;    -- X"2D" for NOMINAL BIAS SETTINGS/X"15" for LOW BIAS SETTINGS FOR TRANSMITTER RF SUBCIRCUITS
						adar_data_frame_in(k)(6)   <= '0' & a14_TO_a11_ADAR_SLECTION & "000" & X"37" & X"06" ;    -- X"06" for NOMINAL BIAS SETTINGS/X"03" for LOW BIAS SETTINGS FOR TRANSMITTER RF SUBCIRCUITS        
						adar_data_frame_in(k)(7)   <= '0' & a14_TO_a11_ADAR_SLECTION & "000" & X"31" & X"04" ;    -- TRANSMIT AND RECEIVE SWITCHING THROUGH TR PIN          
					    FOR i IN 1 TO 4 LOOP -----------Tx/Rx_attenuation and phase I/Q data ----
                            adar_data_frame_in(k)(3*(i-1)+8) <= CH_TX_GAIN_REGISTER_ADDRESS(i) 	  &	CH_ATTN_TX_NEXT_ADAR_MAPPING   (4*(k-1)+ i) ;
                            adar_data_frame_in(k)(3*(i-1)+9) <= CH_TX_PHASE_I_REGISTER_ADDRESS(i) &	CH_PHASE_I_TX_NEXT_ADAR_MAPPING(4*(k-1)+ i) ;
                            adar_data_frame_in(k)(3*(i-1)+10)<= CH_TX_PHASE_Q_REGISTER_ADDRESS(i) &	CH_PHASE_Q_TX_NEXT_ADAR_MAPPING(4*(k-1)+ i) ;  
                            adar_data_frame_in(k)(3*(i-1)+20)<= CH_RX_GAIN_REGISTER_ADDRESS(i)    & CH_ATTN_RX_NEXT_ADAR_MAPPING   (4*(k-1)+ i) ;
                            adar_data_frame_in(k)(3*(i-1)+21)<= CH_RX_PHASE_I_REGISTER_ADDRESS(i) & CH_PHASE_I_RX_NEXT_ADAR_MAPPING(4*(k-1)+ i) ;
                            adar_data_frame_in(k)(3*(i-1)+22)<= CH_RX_PHASE_Q_REGISTER_ADDRESS(i) & CH_PHASE_Q_RX_NEXT_ADAR_MAPPING(4*(k-1)+ i) ;
                        END LOOP;          
						adar_data_frame_in (K)(32) <= '0' & a14_TO_a11_ADAR_SLECTION & "000" & X"2E" & '0' & control_bits_TRM_reg(4*(K-1)+1)(0) & control_bits_TRM_reg(4*(K-1)+2)(0) & control_bits_TRM_reg(4*(K-1)+3)(0) & control_bits_TRM_reg(4*(K-1)+4)(0) & "111" ;----RX ENABLE CH												
						adar_data_frame_in (K)(33) <= '0' & a14_TO_a11_ADAR_SLECTION & "000" & X"2F" & '0' & control_bits_TRM_reg(4*(K-1)+1)(1) & control_bits_TRM_reg(4*(K-1)+2)(1) & control_bits_TRM_reg(4*(K-1)+3)(1) & control_bits_TRM_reg(4*(K-1)+4)(1) & "111" ;----TX ENABLE CH
                        --adar_data_frame_in (k)(34) <= '0' & a14_TO_a11_ADAR_SLECTION & "000" & X"28" & X"03" ;   -- LOADING TX AND RX WORKING REGISTER    
                        word_count_adar_s(k)<= 34;
							IF(adar_spi_busy_flag_s(k) = '0') THEN
								adar_data_frame_in_flag(k)<= '1';
							ELSE
								adar_data_frame_in_flag(k)<= '0';           
							END IF;
            end loop;
 ----------------------------------------------------------------------------------------------------------------------                                    
				WHEN X"20"  => --------------SOFT RESET
				for k in 1 to no_of_adars loop
                        adar_data_frame_in(k)(0)  <= '0' & a14_TO_a11_ADAR_SLECTION & "000" & X"00" & X"81" ;    -- soft_rest adar
                        word_count_adar_s(k)<= 1;
                        IF(SOB_Input_P_VE_edge = '1') THEN
							IF(adar_spi_busy_flag_s(k) = '0') THEN
								adar_data_frame_in_flag(k)<= '1';
							ELSE
								adar_data_frame_in_flag(k)<= '0';           
							END IF;
                        END IF;
                end loop;
-----------------------		
				WHEN OTHERS  =>
					adar_data_frame_in <= (OTHERS =>(OTHERS => (OTHERS =>  '0'))) ;
					adar_data_frame_in_flag  <= (OTHERS =>  '0');
                    word_count_adar_s<= (OTHERS =>  1);
			END CASE ;
		ELSE
		------------POWER ON ADAR RESET---------
	       if wait_counter_power_on_reset_adar > 1000 then
	              power_on_reset_adar_completed_flag<= '1';
	              adar_data_frame_in <= (OTHERS =>(OTHERS => (OTHERS =>  '0'))) ;
	              adar_data_frame_in_flag  <= (OTHERS =>  '0');
	              word_count_adar_s<= (OTHERS =>  1);
	              
	       else
	       	   wait_counter_power_on_reset_adar <= wait_counter_power_on_reset_adar + 1;
           end if;
           if  power_on_reset_adar_completed_flag = '0' THEN 
	              for k in 1 to no_of_adars loop
                   adar_data_frame_in(k)(0)   <= '0' & a14_TO_a11_ADAR_SLECTION & "000" & X"00" & X"81" ;    -- adar register reset
                  	IF(adar_spi_busy_flag_s(k) = '0') THEN
		    			adar_data_frame_in_flag(k)<= '1';
		    		ELSE
		    		    adar_data_frame_in_flag(k)<= '0';           
		    		END IF;
                   word_count_adar_s(k)<= 1;
	              end loop;
	       end if;						
--			adar_data_frame_in <= (OTHERS =>(OTHERS => (OTHERS =>  '0'))) ;
--			adar_data_frame_in_flag  <= (OTHERS =>  '0');
--			word_count_adar_s<= (OTHERS =>  1);
		END IF;
	END IF;
END PROCESS ;  


