    RX_EN_ADAR_6_1          : out std_logic;
    RX_EN_ADAR_3_1          : out std_logic;
    RX_EN_ADAR_4_1          : out std_logic;
    RX_EN_ADAR_7_1          : out std_logic;
    RX_EN_ADAR_8_1          : out std_logic;
    RX_EN_ADAR_9_1          : out std_logic;
    RX_EN_ADAR_10_1         : out std_logic;
    RX_EN_ADAR_11_1         : out std_logic;
    RX_EN_ADAR_12_1         : out std_logic;
    RX_EN_ADAR_13_1         : out std_logic;
    RX_EN_ADAR_14_1         : out std_logic;
    RX_EN_ADAR_15_1         : out std_logic;
    RX_EN_ADAR_16_1         : out std_logic
);
end entity Mode_decoder;

architecture architecture_Mode_decoder of Mode_decoder is

    component spi_wrap is  
        port (
            reset           : in  std_logic;
            CLK_50MHz_I     : in  std_logic;        
            data_frame_in   : in  frame_70word_24bit;
            word_count      : in  integer range 0 to 128;
            data_in_flag    : in  std_logic;
            data_frame_out  : out frame_70word_8bit;
            data_frame_o_v  : out std_logic;
            busy_flag       : out std_logic;
            sdo             : in  std_logic;
            sdio            : out std_logic;
            sclk            : out std_logic;
            cs              : out std_logic            
        );
    end component;

    ------------------------------------------------------------------
    -- ADAR1000 Initialization ROM Sequence (11 Registers)
    ------------------------------------------------------------------
    type init_rom_type is array (0 to 10) of std_logic_vector(15 downto 0);
    constant ADAR_INIT_ROM : init_rom_type := (
        0  => X"0081", -- 1. Soft Reset
        1  => X"0018", -- 2. SDO 4-Wire Enable
        2  => X"3860", -- 3. SPI Control Mode
        3  => X"3100", -- 4. TR Pin Control (SPI Mode)
        4  => X"2D44", -- 5. Power Management
        5  => X"3010", -- 6. Bias / LDO Settings
        6  => X"4AFF", -- 7. Global Enable Matrix
        7  => X"29FF", -- 8. Channel Beam Control 1
        8  => X"2AFF", -- 9. Channel Beam Control 2
        9  => X"2BFF", -- 10. Channel Beam Control 3
        10 => X"2CFF"  -- 11. Channel Beam Control 4
    );

    -- Internal Signals
    signal CMD_TYPE               : std_logic_vector(7 downto 0) := (others => '0');
    signal CHANNEL_SEL            : std_logic_vector(7 downto 0) := (others => '0');
    signal CMD_TYPE_NOP_S         : std_logic_vector(7 downto 0) := (others => '0');
    signal STATUS_TYPE_S          : std_logic_vector(3 downto 0) := (others => '0');
    signal FLASH_CMD_S            : std_logic_vector(7 downto 0) := (others => '0');
    signal FLASH_INPUT_FRAME_S    : frame_10word_8bit            := (others => (others => '0'));

    signal data_adar_flag_raw     : std_logic := '0';
    signal data_adar_flag_d1      : std_logic := '0';

    signal data_frame_in_adar1_s  : frame_70word_24bit := (others => (others => '0'));
    signal data_frame_in_adar2_s  : frame_70word_24bit := (others => (others => '0'));
    signal data_frame_in_adar3_s  : frame_70word_24bit := (others => (others => '0'));
    signal data_frame_in_adar4_s  : frame_70word_24bit := (others => (others => '0'));
    
    signal data_frame_out_1, data_frame_out_2, data_frame_out_3, data_frame_out_4 : frame_70word_8bit;
    signal data_frame_o_v_1, data_frame_o_v_2, data_frame_o_v_3, data_frame_o_v_4 : std_logic;
    signal busy_flag_1, busy_flag_2, busy_flag_3, busy_flag_4                     : std_logic;

    signal word_count_adar1_s     : integer range 0 to 128 := 44;
    signal word_count_adar2_s     : integer range 0 to 128 := 44;
    signal word_count_adar3_s     : integer range 0 to 128 := 44;
    signal word_count_adar4_s     : integer range 0 to 128 := 44;

    signal pw_i     : unsigned(19 downto 0) := x"003E8";  
    signal pri_i    : unsigned(19 downto 0) := x"04E20"; 
    signal prt_cnt  : unsigned(19 downto 0) := x"00000";  
    signal int_trp  : std_logic := '0';

begin 

    ------------------------------------------------------------------
    -- Top-Level Board Driver Control Assignments
    ------------------------------------------------------------------
    FPGA_EN_28NV_DC_DC7149_1 <= '1';
    FPGA_3_3v_1              <= '1';
    PA_ON_1_1                <= '0';
    PA_ON_2_1                <= '0';
    PA_ON_3_1                <= '0';
    PA_ON_4_1                <= '0';

    RX_EN_ADAR_1_1           <= '1';
    RX_EN_ADAR_2_1           <= '1';
    RX_EN_ADAR_5_1           <= '1';
    RX_EN_ADAR_6_1           <= '1';
    RX_EN_ADAR_3_1           <= '1';
    RX_EN_ADAR_4_1           <= '1';
    RX_EN_ADAR_7_1           <= '1';
    RX_EN_ADAR_8_1           <= '1';
    RX_EN_ADAR_9_1           <= '1';
    RX_EN_ADAR_10_1          <= '1';
    RX_EN_ADAR_11_1          <= '1';
    RX_EN_ADAR_12_1          <= '1';
    RX_EN_ADAR_13_1          <= '1';
    RX_EN_ADAR_14_1          <= '1';
    RX_EN_ADAR_15_1          <= '1';
    RX_EN_ADAR_16_1          <= '1';
    
    TR_SW_G1_1               <= '0';
    TR_SW_G2_1               <= '0';
    TR_SW_G3_1               <= '0';
    TR_SW_G4_1               <= '0';

    CMD_TYPE_NOP             <= CMD_TYPE_NOP_S;
    STATUS_TYPE              <= STATUS_TYPE_S;
    FLASH_CMD                <= FLASH_CMD_S;
    FLASH_INPUT_FRAME        <= FLASH_INPUT_FRAME_S;

    FPGA_TX_LOAD_ADAR1       <= int_trp;
    FPGA_RX_LOAD_ADAR1       <= int_trp;
    FPGA_TX_LOAD_ADAR2       <= int_trp;
    FPGA_RX_LOAD_ADAR2       <= int_trp;
    FPGA_TX_LOAD_ADAR3       <= int_trp;
    FPGA_RX_LOAD_ADAR3       <= int_trp;
    FPGA_TX_LOAD_ADAR4       <= int_trp;
    FPGA_RX_LOAD_ADAR4       <= int_trp;

    FPGA_TR_ADAR1            <= '0'; 
    FPGA_TR_ADAR2            <= '0'; 
    FPGA_TR_ADAR3            <= '0'; 
    FPGA_TR_ADAR4            <= '0';

    FPGA_SPI_BUFF_CTRL_G1_1  <= '0';
    FPGA_SPI_BUFF_CTRL_G2_1  <= '0';
    FPGA_SPI_BUFF_CTRL_G3_1  <= '0';
    FPGA_SPI_BUFF_CTRL_G4_1  <= '0';

    DC_DC_Control_Buffer_1   <= '1';
    BUFF_ENABLE_TX_TR_SW_1   <= '1';
    FPGA_EN_n5V_DC_DC7149_1  <= '1';
    FPGA_TX_EN_G1_G2_1       <= '0';
    FPGA_RX_EN_G1_G2_1       <= '0';
     FPGA_RX_EN_G3_G4_1       <= '0';

    ------------------------------------------------------------------
    -- 4 SPI Controller Instantiations
    ------------------------------------------------------------------
    adar1_spi_ctrl_inst: spi_wrap 
        port map(
            reset           => SYS_RESET_I,
            CLK_50MHz_I     => CLK_50MHz_I,
            data_frame_in   => data_frame_in_adar1_s,
            word_count      => word_count_adar1_s,
            data_in_flag    => data_adar_flag_d1,
            data_frame_out  => data_frame_out_1,
            data_frame_o_v  => data_frame_o_v_1,
            busy_flag       => busy_flag_1,
            sdo             => SDO_ADAR1_I,
            sdio            => SDIO_ADAR1_IO,
            sclk            => SCLK_ADAR1_O,
            cs              => CSB_ADAR1_O
        );

    adar2_spi_ctrl_inst: spi_wrap 
        port map(
            reset           => SYS_RESET_I,
            CLK_50MHz_I     => CLK_50MHz_I,
            data_frame_in   => data_frame_in_adar2_s,
            word_count      => word_count_adar2_s,
            data_in_flag    => data_adar_flag_d1,
            data_frame_out  => data_frame_out_2,
            data_frame_o_v  => data_frame_o_v_2,
            busy_flag       => busy_flag_2,
            sdo             => SDO_ADAR2_I,
            sdio            => SDIO_ADAR2_IO,
            sclk            => SCLK_ADAR2_O,
            cs              => CSB_ADAR2_O
        );

    adar3_spi_ctrl_inst: spi_wrap 
        port map(
            reset           => SYS_RESET_I,
            CLK_50MHz_I     => CLK_50MHz_I,
            data_frame_in   => data_frame_in_adar3_s,
            word_count      => word_count_adar3_s,
            data_in_flag    => data_adar_flag_d1,
            data_frame_out  => data_frame_out_3,
            data_frame_o_v  => data_frame_o_v_3,
            busy_flag       => busy_flag_3,
            sdo             => SDO_ADAR3_I,
            sdio            => SDIO_ADAR3_IO,
            sclk            => SCLK_ADAR3_O,
            cs              => CSB_ADAR3_O
        );

    adar4_spi_ctrl_inst: spi_wrap 
        port map(
            reset           => SYS_RESET_I,
            CLK_50MHz_I     => CLK_50MHz_I,
            data_frame_in   => data_frame_in_adar4_s,
            word_count      => word_count_adar4_s,
            data_in_flag    => data_adar_flag_d1,
            data_frame_out  => data_frame_out_4,
            data_frame_o_v  => data_frame_o_v_4,
            busy_flag       => busy_flag_4,
            sdo             => SDO_ADAR4_I,
            sdio            => SDIO_ADAR4_IO,
            sclk            => SCLK_ADAR4_O,
            cs              => CSB_ADAR4_O
        );

    ------------------------------------------------------------------
    -- Command Trigger & Pipeline Process
    ------------------------------------------------------------------
    process(CLK_50MHz_I, SYS_RESET_I) 
    begin 
        if (SYS_RESET_I = '1') then
            CMD_TYPE            <= X"00";
            CHANNEL_SEL         <= X"00";
            CMD_TYPE_NOP_S      <= X"00";
            STATUS_TYPE_S       <= X"0";
            FLASH_CMD_S         <= X"00";
            FLASH_INPUT_FRAME_S <= (others => (others => '0'));
            data_adar_flag_raw  <= '0';
            data_adar_flag_d1   <= '0';
        elsif rising_edge(CLK_50MHz_I) then
            data_adar_flag_raw <= '0';
            data_adar_flag_d1  <= data_adar_flag_raw;

            if FLAG_FRAME = '1' then
                CMD_TYPE    <= RX_FRAME(2);
                CHANNEL_SEL <= RX_FRAME(5);

                if (RX_FRAME(2) >= X"00" and RX_FRAME(2) <= X"05") then
                    data_adar_flag_raw <= '1'; 

                elsif (RX_FRAME(2) = X"08") then
                    CMD_TYPE_NOP_S <= RX_FRAME(2);
                    STATUS_TYPE_S  <= RX_FRAME(5)(3 downto 0);

                elsif (RX_FRAME(2) = X"0A") then
                    FLASH_CMD_S <= RX_FRAME(2);
                    for i in 0 to 9 loop
                        FLASH_INPUT_FRAME_S(i) <= RX_FRAME(i); 
                    end loop;
                end if;
            end if;
        end if;
    end process;

    ------------------------------------------------------------------
    -- Main SPI Frame Construction Process
    ------------------------------------------------------------------
    process(CLK_50MHz_I, SYS_RESET_I) 
    begin
        if (SYS_RESET_I = '1') then
            data_frame_in_adar1_s <= (others => X"000000");
            data_frame_in_adar2_s <= (others => X"000000");
            data_frame_in_adar3_s <= (others => X"000000");
            data_frame_in_adar4_s <= (others => X"000000");
            word_count_adar1_s    <= 44;
            word_count_adar2_s    <= 44;
            word_count_adar3_s    <= 44;
            word_count_adar4_s    <= 44;

        elsif rising_edge(CLK_50MHz_I) then
            if (FLAG_FRAME = '1') then
                case RX_FRAME(2) is

                    ------------------------------------------------------------------
                    -- WHEN 0x00: GLOBAL INITIALIZATION (OPTIMIZED ROM LOOP)
                    ------------------------------------------------------------------
                    when X"00" =>
                        if (RX_FRAME(5) = X"FF") then
                            for chip in 0 to 3 loop
                                for reg in 0 to 10 loop
                                    -- Construct 24-bit SPI word:
                                    -- Bit 23       = '0' (Write Mode)
                                    -- Bits 22..21  = chip address (00, 01, 10, 11)
                                    -- Bits 20..16  = "00000" (Reserved)
                                    -- Bits 15..0   = ADAR_INIT_ROM(reg)
                                    data_frame_in_adar1_s(chip * 11 + reg) <= '0' & std_logic_vector(to_unsigned(chip, 2)) & "00000" & ADAR_INIT_ROM(reg);
                                    data_frame_in_adar2_s(chip * 11 + reg) <= '0' & std_logic_vector(to_unsigned(chip, 2)) & "00000" & ADAR_INIT_ROM(reg);
                                    data_frame_in_adar3_s(chip * 11 + reg) <= '0' & std_logic_vector(to_unsigned(chip, 2)) & "00000" & ADAR_INIT_ROM(reg);
                                    data_frame_in_adar4_s(chip * 11 + reg) <= '0' & std_logic_vector(to_unsigned(chip, 2)) & "00000" & ADAR_INIT_ROM(reg);
                                end loop;
                            end loop;

                            word_count_adar1_s <= 44;
                            word_count_adar2_s <= 44;
                            word_count_adar3_s <= 44;
                            word_count_adar4_s <= 44;
                        end if;

                    ------------------------------------------------------------------
                    -- WHEN 0x02: RX CALIBRATION MODE
                    ------------------------------------------------------------------
                    when X"02" =>
                        data_frame_in_adar1_s(0) <= "00000000" & x"10" & RX_FRAME(6); -- Channel Gain
                        data_frame_in_adar1_s(1) <= "00000000" & x"14" & RX_FRAME(7); -- Channel Phase I
                        data_frame_in_adar1_s(2) <= "00000000" & x"15" & RX_FRAME(8); -- Channel Phase Q
                        data_frame_in_adar1_s(3) <= "00000000" & x"2E7F";             -- Enable RX
                        data_frame_in_adar1_s(4) <= "00000000" & x"2801";             -- Hardware Latch

                        data_frame_in_adar2_s <= data_frame_in_adar1_s;
                        data_frame_in_adar3_s <= data_frame_in_adar1_s;
                        data_frame_in_adar4_s <= data_frame_in_adar1_s;

                        word_count_adar1_s <= 5;
                        word_count_adar2_s <= 5;
                        word_count_adar3_s <= 5;
                        word_count_adar4_s <= 5;

                    ------------------------------------------------------------------
                    -- WHEN 0x03: TX CALIBRATION MODE
                    ------------------------------------------------------------------
                    when X"03" =>
                        data_frame_in_adar1_s(0) <= "00000000" & x"362D";             -- Power up TX Bias 1
                        data_frame_in_adar1_s(1) <= "00000000" & x"3706";             -- Power up TX Bias 2
                        data_frame_in_adar1_s(2) <= "00000000" & x"10" & RX_FRAME(6); -- Channel Gain
                        data_frame_in_adar1_s(3) <= "00000000" & x"14" & RX_FRAME(7); -- Channel Phase I
                        data_frame_in_adar1_s(4) <= "00000000" & x"15" & RX_FRAME(8); -- Channel Phase Q
                        data_frame_in_adar1_s(5) <= "00000000" & x"2F7F";             -- Enable TX
                        data_frame_in_adar1_s(6) <= "00000000" & x"2801";             -- Hardware Latch

                        data_frame_in_adar2_s <= data_frame_in_adar1_s;
                        data_frame_in_adar3_s <= data_frame_in_adar1_s;
                        data_frame_in_adar4_s <= data_frame_in_adar1_s;

                        word_count_adar1_s <= 7;
                        word_count_adar2_s <= 7;
                        word_count_adar3_s <= 7;
                        word_count_adar4_s <= 7;

                    when others =>
                        null;
                end case;
            end if;
        end if;
    end process;

    ------------------------------------------------------------------
    -- Pulse Generator Process
    ------------------------------------------------------------------
    process(CLK_10MHZ_I, SYS_RESET_I) 
    begin
        if SYS_RESET_I = '1' then
            prt_cnt <= (others => '0');
            int_trp <= '0';
        elsif rising_edge(CLK_10MHZ_I) then
            if prt_cnt >= pri_i then
                prt_cnt <= (others => '0');
            else
                prt_cnt <= prt_cnt + 1;
            end if;

            if ((prt_cnt < pw_i) and (prt_cnt > 0)) then
                int_trp <= '1';
            else
                int_trp <= '0'; 
            end if;
        end if;
    end process;

end architecture architecture_Mode_decoder;
