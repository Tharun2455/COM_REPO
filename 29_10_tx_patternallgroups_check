    -- Pass INT_TRP_I directly to hardware latch pins
    FPGA_TX_LOAD_ADAR1       <= INT_TRP_I;
    FPGA_RX_LOAD_ADAR1       <= INT_TRP_I;
    FPGA_TX_LOAD_ADAR2       <= INT_TRP_I;
