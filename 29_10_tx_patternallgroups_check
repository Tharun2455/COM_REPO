architecture architecture_Mode_decoder of Mode_decoder is

    component spi_wrap is  
        port (
            reset           : in  std_logic;
            CLK_50MHz_I     : in  std_logic;        
            data_frame_in   : in  frame_70word_24bit;
            word_count      : in  integer range 0 to 128;
            data_in_flag    : in  std_logic;
            data_frame_out  : out frame_70word_8bit;
            data_frame_o_v  : out std_logic;
            busy_flag       : out std_logic;
            sdo             : in  std_logic;
            sdio            : out std_logic;
            sclk            : out std_logic;
            cs              : out std_logic            
        );
    end component;

    ------------------------------------------------------------------
    -- ADAR1000 Initialization ROM Sequence (11 Registers)
    ------------------------------------------------------------------
    type init_rom_type is array (0 to 10) of std_logic_vector(15 downto 0);
    constant ADAR_INIT_ROM : init_rom_type := (
        0  => X"0081", -- 1. Soft Reset
        1  => X"0018", -- 2. SDO 4-Wire Enable
        2  => X"3860", -- 3. SPI Control Mode
        3  => X"3100", -- 4. TR Pin Control (SPI Mode)
        4  => X"2D44", -- 5. Power Management
        5  => X"3010", -- 6. Bias / LDO Settings
        6  => X"4AFF", -- 7. Global Enable Matrix
        7  => X"29FF", -- 8. Channel Beam Control 1
        8  => X"2AFF", -- 9. Channel Beam Control 2
        9  => X"2BFF", -- 10. Channel Beam Control 3
        10 => X"2CFF"  -- 11. Channel Beam Control 4
    );

    -- Internal Signals
    signal CMD_TYPE               : std_logic_vector(7 downto 0) := (others => '0');
    signal CHANNEL_SEL            : std_logic_vector(7 downto 0) := (others => '0');
    signal CMD_TYPE_NOP_S         : std_logic_vector(7 downto 0) := (others => '0');
    signal STATUS_TYPE_S          : std_logic_vector(3 downto 0) := (others => '0');
    signal FLASH_CMD_S            : std_logic_vector(7 downto 0) := (others => '0');
    signal FLASH_INPUT_FRAME_S    : frame_10word_8bit            := (others => (others => '0'));
    
    signal adar_rst_cnt           : unsigned(27 downto 0)        := (others => '0');
    signal data_adar_flag_raw     : std_logic                    := '0';
    signal por_flag_raw           : std_logic                    := '0';
    signal data_adar_flag_d1      : std_logic                    := '0';

    signal data_frame_in_adar1_s  : frame_70word_24bit := (others => (others => '0'));
    signal data_frame_in_adar2_s  : frame_70word_24bit := (others => (others => '0'));
    signal data_frame_in_adar3_s  : frame_70word_24bit := (others => (others => '0'));
    signal data_frame_in_adar4_s  : frame_70word_24bit := (others => (others => '0'));
    
    signal data_frame_out_1, data_frame_out_2, data_frame_out_3, data_frame_out_4 : frame_70word_8bit;
    signal data_frame_o_v_1, data_frame_o_v_2, data_frame_o_v_3, data_frame_o_v_4 : std_logic;
    signal busy_flag_1, busy_flag_2, busy_flag_3, busy_flag_4                     : std_logic;

