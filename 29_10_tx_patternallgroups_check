    signal word_count_adar2_s     : integer range 0 to 128 := 44;
    signal word_count_adar3_s     : integer range 0 to 128 := 44;
    signal word_count_adar4_s     : integer range 0 to 128 := 44;
    
    signal pw_i                   : unsigned(19 downto 0)  := x"003E8";  -- 1000 
    signal pri_i                  : unsigned(19 downto 0)  := x"04E20";  -- 20000        
    signal prt_cnt                : unsigned(19 downto 0)  := x"00000";  
