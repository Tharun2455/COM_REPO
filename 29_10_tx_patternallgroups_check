            --data_adar_flag_raw <= '0';
            --
            ---- Combine UART trigger flag and Power-On-Reset flag cleanly without multiple drivers
            --data_adar_flag_d1  <= data_adar_flag_raw or por_flag_raw;
--
            --if FLAG_FRAME = '1' then
                --packet_size_id <= RX_FRAME(1);
                --CMD_TYPE       <= RX_FRAME(2);
                --CHANNEL_SEL    <= RX_FRAME(5);
--
                --if (RX_FRAME(2) >= X"00" and RX_FRAME(2) <= X"05") then
                    --data_adar_flag_raw <= '1'; 
                     --
                     --
                     --elsif (RX_FRAME(1) =X"3F" and  RX_FRAME(2)=X"06")then
                        --data_adar_flag_raw <= '1'; 
                          --
                            --elsif (RX_FRAME(1) =X"3F")then
                                        --trm_controlbyte  <=RX_FRAME(9); 
                                        --
               --
                 --elsif (RX_FRAME(2) = X"08") then
                    --CMD_TYPE_NOP_S <= RX_FRAME(2);
                    --STATUS_TYPE_S  <= RX_FRAME(5)(3 downto 0);
--
                --elsif (RX_FRAME(2) = X"0A") then
                    --FLASH_CMD_S <= RX_FRAME(2);
                    --for i in 0 to 9 loop
                        --FLASH_INPUT_FRAME_S(i) <= RX_FRAME(i); 
                    --end loop;
                --end if;
            --end if;
        --end if;
    --end process;
    


    ------------------------------------------------------------------
    -- Main SPI Frame Construction Process
    ------------------------------------------------------------------
    process(CLK_50MHz_I, SYS_RESET_I) 
    begin
        if (SYS_RESET_I = '1') then
            data_frame_in_adar1_s <= (others => X"000000");
            data_frame_in_adar2_s <= (others => X"000000");
            data_frame_in_adar3_s <= (others => X"000000");
            data_frame_in_adar4_s <= (others => X"000000");
            word_count_adar1_s    <= 44;
            word_count_adar2_s    <= 44;
            word_count_adar3_s    <= 44;
            word_count_adar4_s    <= 44;

        elsif rising_edge(CLK_50MHz_I) then
            if (FLAG_FRAME = '1') then
                case RX_FRAME(2) is

                    ------------------------------------------------------------------
                    -- WHEN 0x00: GLOBAL INITIALIZATION (OPTIMIZED ROM LOOP)
                    ------------------------------------------------------------------
                    when X"00" =>
                        if (RX_FRAME(5) = X"FF") then
                            for chip in 0 to 3 loop
                                for reg in 0 to 10 loop
                                    data_frame_in_adar1_s(chip * 11 + reg) <= '0' & std_logic_vector(to_unsigned(chip, 2)) & "00000" & ADAR_INIT_ROM(reg);
                                    data_frame_in_adar2_s(chip * 11 + reg) <= '0' & std_logic_vector(to_unsigned(chip, 2)) & "00000" & ADAR_INIT_ROM(reg);
                                    data_frame_in_adar3_s(chip * 11 + reg) <= '0' & std_logic_vector(to_unsigned(chip, 2)) & "00000" & ADAR_INIT_ROM(reg);
                                    data_frame_in_adar4_s(chip * 11 + reg) <= '0' & std_logic_vector(to_unsigned(chip, 2)) & "00000" & ADAR_INIT_ROM(reg);
                                end loop;
                            end loop;

                            word_count_adar1_s <= 44;
                            word_count_adar2_s <= 44;
                            word_count_adar3_s <= 44;
                            word_count_adar4_s <= 44;
                        end if;

