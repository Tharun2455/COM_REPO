    -- Pass INT_TRP_I to TR pins ONLY during TX Mode (0x03); hold 0 in RX (0x02) & Init (0x00)
    --FPGA_TR_ADAR1            <= INT_TRP_I when (CMD_TYPE = X"03") else '0';
    --FPGA_TR_ADAR2            <= INT_TRP_I when (CMD_TYPE = X"03") else '0';
