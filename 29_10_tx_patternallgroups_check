    ------------------------------------------------------------------
    -- 4 SPI Controller Instantiations
    ------------------------------------------------------------------
    adar1_spi_ctrl_inst: spi_wrap 
        port map(
            reset           => SYS_RESET_I,
            CLK_50MHz_I     => CLK_50MHz_I,
            data_frame_in   => data_frame_in_adar1_s,
            word_count      => word_count_adar1_s,
            data_in_flag    => data_adar_flag_d1,
            data_frame_out  => data_frame_out_1,
            data_frame_o_v  => data_frame_o_v_1,
            busy_flag       => busy_flag_1,
            sdo             => SDO_ADAR1_I,
            sdio            => SDIO_ADAR1_IO,
            sclk            => SCLK_ADAR1_O,
            cs              => CSB_ADAR1_O
        );

    adar2_spi_ctrl_inst: spi_wrap 
        port map(
            reset           => SYS_RESET_I,
            CLK_50MHz_I     => CLK_50MHz_I,
            data_frame_in   => data_frame_in_adar2_s,
            word_count      => word_count_adar2_s,
            data_in_flag    => data_adar_flag_d1,
            data_frame_out  => data_frame_out_2,
            data_frame_o_v  => data_frame_o_v_2,
            busy_flag       => busy_flag_2,
            sdo             => SDO_ADAR2_I,
            sdio            => SDIO_ADAR2_IO,
            sclk            => SCLK_ADAR2_O,
            cs              => CSB_ADAR2_O
        );

    adar3_spi_ctrl_inst: spi_wrap 
        port map(
            reset           => SYS_RESET_I,
            CLK_50MHz_I     => CLK_50MHz_I,
            data_frame_in   => data_frame_in_adar3_s,
            word_count      => word_count_adar3_s,
            data_in_flag    => data_adar_flag_d1,
            data_frame_out  => data_frame_out_3,
            data_frame_o_v  => data_frame_o_v_3,
            busy_flag       => busy_flag_3,
            sdo             => SDO_ADAR3_I,
            sdio            => SDIO_ADAR3_IO,
            sclk            => SCLK_ADAR3_O,
            cs              => CSB_ADAR3_O
        );

    adar4_spi_ctrl_inst: spi_wrap 
        port map(
            reset           => SYS_RESET_I,
            CLK_50MHz_I     => CLK_50MHz_I,
            data_frame_in   => data_frame_in_adar4_s,
            word_count      => word_count_adar4_s,
            data_in_flag    => data_adar_flag_d1,
            data_frame_out  => data_frame_out_4,
            data_frame_o_v  => data_frame_o_v_4,
            busy_flag       => busy_flag_4,
            sdo             => SDO_ADAR4_I,
            sdio            => SDIO_ADAR4_IO,
            sclk            => SCLK_ADAR4_O,
            cs              => CSB_ADAR4_O
        );

    ------------------------------------------------------------------
    -- Command Trigger & Pipeline Process
    ------------------------------------------------------------------
    process(CLK_50MHz_I, SYS_RESET_I) 
    begin 
        if (SYS_RESET_I = '1') then
            CMD_TYPE            <= X"00";
            CHANNEL_SEL         <= X"00";
            CMD_TYPE_NOP_S      <= X"00";
            STATUS_TYPE_S       <= X"0";
            packet_size_id      <= X"00";
            FLASH_CMD_S         <= X"00";
            FLASH_INPUT_FRAME_S <= (others => (others => '0'));
            data_adar_flag_raw  <= '0';
            data_adar_flag_d1   <= '0';
        elsif rising_edge(CLK_50MHz_I) then
            data_adar_flag_raw <= '0';
            
            -- Combine UART trigger flag and Power-On-Reset flag cleanly without multiple drivers
            data_adar_flag_d1  <= data_adar_flag_raw or por_flag_raw;

            if FLAG_FRAME = '1' then
                CMD_TYPE    <= RX_FRAME(2);
                CHANNEL_SEL <= RX_FRAME(5);

                if (RX_FRAME(2) >= X"00" and RX_FRAME(2) <= X"05") then
                    data_adar_flag_raw <= '1';
                  
                  ELSIF (RX_FRAME(2) =X"06")then
                     if(RX_FRAME(1) =X"40")THEN
                     data_adar_flag_raw <='1';
                     end if;
                     
                ELSIF (RX_FRAME(2) =X"07")then
                     if(RX_FRAME(1) =X"40")THEN
                     data_adar_flag_raw <='1';
                     end if;

                elsif (RX_FRAME(2) = X"08") then
                    CMD_TYPE_NOP_S <= RX_FRAME(2);
                    STATUS_TYPE_S  <= RX_FRAME(5)(3 downto 0);

                elsif (RX_FRAME(2) = X"0A") then
                    FLASH_CMD_S <= RX_FRAME(2);
                    for i in 0 to 9 loop
                        FLASH_INPUT_FRAME_S(i) <= RX_FRAME(i); 
                    end loop;
                end if;
            end if;
        end if;
    end process;
         --process(CLK_50MHz_I, SYS_RESET_I) 
    --begin 
        --if (SYS_RESET_I = '1') then
            --CMD_TYPE            <= X"00";
            --CHANNEL_SEL         <= X"00";
            --CMD_TYPE_NOP_S      <= X"00";
